                </mxCell>
                <mxCell id="a0_ph6_goal" value="&lt;b&gt;Goal:&lt;/b&gt; RCA per failure: App vs Broken XPath vs Script.&lt;br/&gt;&lt;i&gt;Skill: investigate-failed-tests&lt;/i&gt;&lt;br/&gt;🟡 → Phase 3 (xpath-doc-generator) | 🟠 → Phase 4 | 🔴 → Jira QG + Epic link" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#312E81;" parent="1" vertex="1">
