                </mxCell>
                <mxCell id="a0_ph6_in" value="INPUT&#10;① Phase 5 console log&#10;② TestResults/*.trx&#10;③ Cross-ref pom.md / locators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366F1;fontSize=10;fontColor=#312E81;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="352" y="1384" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a0_ph6_action" value="6.1 Parse: TC name, error, stack, XPath (from pom.md)&#10;6.2 Live browser → decision tree 🔴 App / 🟡 XPath / 🟠 Script&#10;6.3 Save TestResults/FailureReport_YYYYMMDD_HHMMSS.md (format per v2 spec)&#10;6.4 Present report → route each failure (remediation table)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366F1;fontSize=11;fontColor=#1a1a1a;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="528" y="1376" width="560" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="a0_ph6_route" value="&lt;b&gt;Remediation (6.4)&lt;/b&gt;&#10;🟡 Broken XPath → ↪ Phase 3 (xpath-doc-generator); no Jira&#10;🟠 Script bug → ↪ Phase 4; no Jira&#10;🔴 App bug → 📋 Jira QG + evidence + link Epic&#10;✅ All pass investigation → final Test Execution Summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#818CF8;fontSize=10;fontColor=#1e1b4b;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1104" y="1376" width="465" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="a0_ph6_note" value="Jira bug only for confirmed 🔴 App Bug — full evidence: steps, stack trace, expected vs actual, screenshots/logs; link to QG Epic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A5B4FC;fontSize=10;fontStyle=2;fontColor=#4338CA;dashed=1;" parent="1" vertex="1">
